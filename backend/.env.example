# Load these in your shell before starting the backend from backend/.
VINCERO_MFA_COMMAND='["python3","-m","vincero_backend.mfa_container","--audio","{audio}","--transcript","{transcript}","--dictionary","{dictionary}","--acoustic-model","{acoustic_model}","--output","{output}"]'
VINCERO_MFA_DICTIONARY_ITALIAN=italian_cv
VINCERO_MFA_ACOUSTIC_MODEL_ITALIAN=italian_cv
